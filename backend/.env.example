ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://tienda:tienda@localhost:5432/tienda_sistema
SECRET_KEY=change-me

# --- Module B: Inventario (Supabase Storage: fotos de boleta y de producto) ---
# Sin estas variables, POST /storage/upload falla y sin foto no se puede
# enviar una solicitud de ingreso (HU-B06).
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-aqui
SUPABASE_STORAGE_BUCKET_BOLETAS=boletas
SUPABASE_STORAGE_BUCKET_PRODUCTOS=productos
# Vigencia de las URLs firmadas de boletas, en segundos (default: 1 año).
SUPABASE_SIGNED_URL_TTL=31536000

# --- Module D: Documentos (Boletas/Drive, Notificaciones) ---
# Google Drive (Service Account)
GOOGLE_DRIVE_CREDENTIALS_JSON=path/to/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Correo (SMTP - Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=app-password-de-gmail
CORREO_REMITENTE=tu-correo@gmail.com
CORREO_DESTINO=tu-correo@gmail.com
