ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://tienda:tienda@localhost:5432/tienda_sistema
SECRET_KEY=change-me

# --- Google Drive (OAuth) ---
# Un solo Drive para todo: las fotos de boleta del Módulo B (boletas/ingresos/),
# las notas de venta (boletas/ventas/) y los respaldos del Módulo D (respaldos/).
# Sin autorizar la cuenta, POST /storage/upload falla y sin foto no se puede
# enviar una solicitud de ingreso (HU-B06).
GOOGLE_DRIVE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=tu-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/drive/callback
GOOGLE_DRIVE_FOLDER_ID=id-de-la-carpeta-raiz

# --- Module D: Documentos (Notificaciones) ---

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Correo (SMTP - Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=app-password-de-gmail
CORREO_REMITENTE=tu-correo@gmail.com
CORREO_DESTINO=tu-correo@gmail.com
